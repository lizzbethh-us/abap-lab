@Metadata.layer: #CORE

// 1. #CUSTOMER
// 2.
// ...
// 5. #CORE  prioridad mas baja

@UI: { headerInfo : { typeName: 'Travel', 
                      typeNamePlural: 'Travels',
                      title: { type :#STANDARD,
                               value: 'TravelID' } },
        presentationVariant: [{ sortOrder: [{by: 'TravelID',
                                             direction : #DESC}],
                                 visualizations: [{ type: #AS_LINEITEM }] }] }  //ESTA ES LA PLANTILLA
annotate entity Z_C_TRAVEL_LGL_01
    with 
{
    
    //face sheet
    @UI.facet: [{ id : 'TravelMasterData',  // PARA USO INTERNO
                  purpose: #STANDARD,
                  type: #IDENTIFICATION_REFERENCE,  // TENEMOS POSIBILIDAD DE NAVEGAR AL DETALLE
                  label: 'Travel Master Data',  // ETIQUETA QUE VEN USUARIOS
                  position: 10}] // LA POSICION ES OBLIGATORIA CUANDO SE TIENEN MAS PESTAÑAS
    TravelUUID;   
    
    @UI: { lineItem: [{ position: 10,
                     importance: #HIGH,
                     label: 'Travel ID' }],
           selectionField: [{ position: 10 }],
           identification: [{ position: 10 }] }  //-> esta es la posicion en la pantalla que le vamos a asignar   
    TravelID;
    @Consumption.valueHelpDefinition: [{ entity: { name: '/DMO/I_Agency_StdVH',
                                                   element: 'AgencyID' },
                                          useForValidation: true }]
    @UI: {lineItem: [{ position: 20,
                     importance: #HIGH }],
          selectionField: [{ position: 20 }],
          identification: [{ position: 20 }] }
    AgencyID;
    @Consumption.valueHelpDefinition: [{ entity: { name: '/DMO/I_Customer_StdVH',
                                                   element: 'CustomerID' },
                                          useForValidation: true }]
    
    @UI: {lineItem: [{ position: 30,
                     importance: #HIGH }],
          selectionField: [{ position: 30 }],
          identification: [{ position: 30 }] }
    CustomerID;
    
    @UI:{ lineItem: [{ position: 40,
                     importance: #MEDIUM }],
         identification: [{ position: 40 }]}
    BeginDate;
    
    @UI: { lineItem: [{ position: 50,
                     importance: #MEDIUM}],
           identification: [{ position: 50 }] }
    EndDate;
    
    @UI.lineItem: [{ position: 60,
                     importance: #LOW}]
    @UI.identification: [{ position: 60 }]
    BookingFee;
    
    @UI.lineItem: [{ position: 70,
                     importance: #HIGH }]
     @UI.identification: [{ position: 70 }]
    TotalPrice;
    @Consumption.valueHelpDefinition: [{ entity: { name: 'I_CurrencyStdVH',
                                                   element: 'CurrencyID' },
                                          useForValidation: true }]
    @UI.lineItem: [{ position: 80,
                     importance: #HIGH }]
     @UI.identification: [{ position: 80 }]
    CurrencyCode;
    @Consumption.valueHelpDefinition: [{ entity: { name: '/DMO/I_Overall_Status_VH',
                                                   element: 'OverallStatus' } }]
    @UI: {lineItem: [{ position: 90,
                     importance: #LOW }],
          selectionField: [{ position: 40 }],
          textArrangement: #TEXT_ONLY, 
          identification: [{ position: 90 }] }
          
    OverallStatus;
    
}